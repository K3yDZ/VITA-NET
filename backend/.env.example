# Copy this file to .env and fill it.
# You only need ONE provider — the one you want will be picked automatically.
# Priority: OpenRouter -> NVIDIA NIM -> Gemini -> Anthropic -> rule-based fallback (no key needed).
#
# 3 OpenRouter keys + auto model failover is supported.
# Put keys comma-separated OR use _1/_2/_3 vars — both work.

# --- OpenRouter (RECOMMENDED - cheapest/fastest first) ---
# Option A: comma-separated (3 keys in one line)
# OPENROUTER_API_KEY=sk-or-v1-aaa,sk-or-v1-bbb,sk-or-v1-ccc
# Option B: numbered vars
# OPENROUTER_API_KEY_1=sk-or-v1-aaa
# OPENROUTER_API_KEY_2=sk-or-v1-bbb
# OPENROUTER_API_KEY_3=sk-or-v1-ccc
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Models tried in order when one hits 429/quota. Override if you want.
# Default order: gpt-4o-mini -> gemini-2.0-flash -> llama-3.3-70b -> claude-sonnet-4
OPENROUTER_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001,meta-llama/llama-3.3-70b-instruct,anthropic/claude-sonnet-4

# Skip OpenRouter tier when credits are low (falls back to NVIDIA NIM next)
# ADVISOR_SKIP_OPENROUTER=0

# --- NVIDIA NIM (5 keys, OpenAI-compatible, generous free tier) ---
# Get keys from https://build.nvidia.com (free tier) -> API Keys.
# Multiple keys give longer life via round-robin failover (429 -> next key).
# Option A: comma-separated
# NVIDIA_API_KEY=nvapi-aaa,nvapi-bbb,nvapi-ccc,nvapi-ddd,nvapi-eee
# Option B: numbered vars (also NVIDIA_NIM_API_KEY_1..5 alias supported)
# NVIDIA_API_KEY_1=nvapi-aaa
# NVIDIA_API_KEY_2=nvapi-bbb
# NVIDIA_API_KEY_3=nvapi-ccc
# NVIDIA_API_KEY_4=nvapi-ddd
# NVIDIA_API_KEY_5=nvapi-eee
NVIDIA_API_KEY=
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=

# Models tried in order when one hits 429/quota (OpenAI-compatible)
# Default: confirmed free-tier models on integrate.api.nvidia.com
NVIDIA_MODELS=meta/llama-3.3-70b-instruct,meta/llama-3.3-8b-instruct,meta/llama-3.1-70b-instruct,meta/llama-3.1-8b-instruct,microsoft/phi-3.5-mini-instruct,microsoft/phi-3-mini-128k-instruct,google/gemma-2-9b-it,google/gemma-2-2b-it,nvidia/nemotron-3-ultra-550b-a55b,mistral/mistral-7b-instruct-v0.3,deepseek/deepseek-chat,cohere/command-r

# Override base URL if needed (default https://integrate.api.nvidia.com/v1)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Google Gemini (direct API) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# --- Anthropic direct (fallback, optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# --- Optional: force rule-only mode even with keys set ---
# ADVISOR_FORCE_LOCAL=0

# --- Auth (required for /api/reset and protected endpoints) ---
# JWT_SECRET=your-secret-key-here (min 32 chars recommended)

# --- Proxy trust list (for X-Forwarded-For) ---
# TRUSTED_PROXIES=proxy1,proxy2
